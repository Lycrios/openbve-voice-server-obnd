PORT=8080
HTTPS=false
# SSL_KEY_PATH=./certs/localhost+2-key.pem
# SSL_CERT_PATH=./certs/localhost+2.pem

# Radio
# Seconds between WebSocket pings. Keeps idle radio links alive through a
# reverse proxy and detects peers that vanished without closing. Must be
# comfortably below nginx's proxy_read_timeout (60s by default). Default 30.
# WS_HEARTBEAT_SECONDS=30

# Seconds one operator may hold a channel before another operator's PTT request
# takes the line instead of queueing behind it. Not a hard transmission limit:
# a holder is only cut off if somebody else actually wants to talk.
# Set to 0 to disable interruption and always queue. Default 35.
# PTT_INTERRUPT_SECONDS=35

# Security
# AUTH_PASSWORD=change-me
# SESSION_SECRET=replace-with-long-random-secret
# SESSION_TTL_SECONDS=43200
# ALLOWED_ORIGINS=https://radio.yourdomain.com,https://www.radio.yourdomain.com
# ALLOWED_IPS=203.0.113.10,198.51.100.23
# REQUIRE_HTTPS=true
# TRUST_PROXY=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_WS_MAX=60

# Legacy access token mode (optional)
# ACCESS_TOKEN=legacy-shared-token
